generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int            @id @default(autoincrement())
  phoneNumber       String?        @unique
  password          String?
  email             String?        @unique
  googleId          String?        @unique
  appleId           String?        @unique
  name              String?
  isVerified        Boolean        @default(false)
  isBlocked         Boolean        @default(false)
  otp               String?
  otpExpiresAt      DateTime?
  otpResendCount    Int            @default(0)
  lastOtpSentAt     DateTime?
  latitude          Float?
  longitude         Float?
  address           String?
  pushToken         String?
  passwordChangedAt DateTime?
  allergies         String[]
  orders            Order[]
  reviews           Review[]
  favorites         Favorite[]
  refreshTokens     RefreshToken[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

enum AdminRole {
  OWNER
  SUPPORT
  OPERATIONS
  FINANCE
}

model Admin {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  password       String
  name           String
  role           AdminRole  @default(OWNER)
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime?
  auditLogs      AuditLog[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Vendor {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String
  nameArabic   String?
  description  String?
  imageUrl     String?
  category     String?
  latitude     Float?
  longitude    Float?
  address      String?
  phone        String?
  openingHours String?
  closingHours String?
  rating                  Float?
  reviewCount             Int           @default(0)
  status                  VendorStatus  @default(APPROVED)
  passwordResetToken      String?
  passwordResetExpiresAt  DateTime?
  listings                SurpriseBox[]
  reviews                 Review[]
  favorites               Favorite[]
  createdAt               DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
}

model SurpriseBox {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  imageUrl      String?
  price         Float
  originalPrice Float?
  quantity      Int
  allergens     String[]
  ingredients   String[]
  pickupStart   DateTime
  pickupEnd     DateTime
  vendorId              Int
  vendor                Vendor   @relation(fields: [vendorId], references: [id])
  orders                Order[]
  notifiedFollowersAt   DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  ON_THE_WAY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PickupStatus {
  PENDING
  COLLECTED
  NO_SHOW
}

model Order {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id])
  surpriseBoxId   Int
  surpriseBox     SurpriseBox    @relation(fields: [surpriseBoxId], references: [id])
  status          OrderStatus    @default(PENDING)
  pickupStatus    PickupStatus   @default(PENDING)
  orderCode       String         @unique
  quantity        Int            @default(1)
  deliveryMethod  DeliveryMethod
  deliveryAddress       String?
  pickupReminderSentAt  DateTime?
  review                Review?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  vendorId  Int
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  Int
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  deviceInfo String?
  ipAddress  String?
  isRevoked  Boolean  @default(false)

  @@index([userId])
  @@index([token])
}
