# Local physical-device development. Replace this address with your computer's
# current LAN IP and keep the /api suffix.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:4000/api

# Public OAuth client identifier. This value is bundled into the app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=505490363229-enso09ftem17pq92gc6e4i60tv0qsk0d.apps.googleusercontent.com

# Authentica handles SMS OTP. Firebase remains enabled for push notifications.
EXPO_PUBLIC_USE_FIREBASE_PHONE_AUTH=false
